<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CLIP FACTORY AI</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090909;color:white;font-family:Arial,sans-serif;padding:20px}
header{text-align:center;padding:25px 0}
h1{color:#ff3030;font-size:28px;letter-spacing:2px}
.subtitle{color:#999;font-size:13px}
.card{background:#171717;border:1px solid #303030;border-radius:14px;padding:18px;margin:15px 0}
h2{font-size:17px}
input{width:100%;padding:14px;background:#080808;border:1px solid #444;border-radius:8px;color:white;margin:10px 0}
button{width:100%;padding:14px;background:#e32636;border:0;border-radius:8px;color:white;font-weight:bold;margin-top:12px}
button:active{background:#a71925}
.small{color:#999;font-size:12px;line-height:1.5}
.status{color:#35d07f;font-size:13px}
</style>
</head>
<body>
<header>
<h1>CLIP FACTORY AI</h1>
<div class="subtitle">TU ESTUDIO INTELIGENTE DE CLIPS</div>
</header>

<div class="card">
<h2>🎬 Crear nuevos clips</h2>
<p class="small">Añade un video o una transmisión que tengas autorización para utilizar.</p>
<input type="file" id="video" accept="video/*">
<input type="url" id="url" placeholder="Enlace de tu video autorizado">
<label class="small">
<input type="checkbox" id="permission" style="width:auto">
Confirmo que tengo autorización para usar este contenido.
</label>
<button onclick="prepare()">ANALIZAR CONTENIDO</button>
<p id="status" class="status"></p>
</div>

<div class="card">
<h2>⚙️ Configuración</h2>
<p>Máximo de clips: <strong>10</strong></p>
<p>Formato: <strong>Vertical 9:16</strong></p>
<p>Publicación: <strong>Manual con aprobación</strong></p>
<p>Estado: <strong>Modo gratuito</strong></p>
</div>

<div class="card">
<h2>✂️ Tus clips</h2>
<p class="small" id="clips">Todavía no hay clips generados.</p>
</div>

<script>
function prepare(){
const file=document.getElementById('video').files[0];
const url=document.getElementById('url').value;
const permission=document.getElementById('permission').checked;
const status=document.getElementById('status');
if(!permission){status.textContent='Debes confirmar que tienes autorización.';return;}
if(!file&&!url){status.textContent='Selecciona un video o introduce un enlace.';return;}
status.textContent='Contenido registrado. El motor de análisis se conectará en la siguiente etapa.';
}
</script>
</body>
</html>